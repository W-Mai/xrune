<!--
  OG / Twitter Card meta. mdbook itself doesn't emit these, so link
  previews on Slack / Discord / iMessage / 微信 fall back to the favicon
  (a 32×32 ICO that renders as an illegible square in the 1200×628 slot).

  og:image points at the card the landing page ships (docs/landing). {{ chapter_title }}
  comes from mdbook's handlebars context and gives every page a distinct title.
-->
<meta property="og:title" content="{{ chapter_title }} · xrune">
<meta property="og:description" content="xrune — a declarative UI DSL proc-macro framework with pluggable code-generation backends.">
<meta property="og:type" content="article">
<meta property="og:image" content="https://xrune.to01.icu/og-card.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="628">
<meta property="og:image:alt" content="xrune · The Grimoire">
<meta property="og:site_name" content="xrune documentation">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ chapter_title }} · xrune">
<meta name="twitter:description" content="xrune — a declarative UI DSL proc-macro framework with pluggable code-generation backends.">
<meta name="twitter:image" content="https://xrune.to01.icu/og-card.jpg">

<!--
  Search: mdbook's bundled elasticlunr drops CJK tokens, so book.toml turns
  it off and CI indexes both trees with Pagefind 1.4's extended build, the one
  that segments Chinese. Each tree loads its own index (path_to_root keeps
  /zh-CN/ pages on /zh-CN/pagefind/).

  Pigments: the landing page's syntax highlighter, served from the site
  root, so a casting reads the same in the book as in the Forge. Without it
  (a bare `mdbook serve`) the book keeps highlight.js, inked the same way.

  Only head-valid elements in this partial: a <div> here would close <head>
  early and push the viewport meta and every stylesheet into <body>.
-->
<link rel="stylesheet" href="{{ path_to_root }}pagefind/pagefind-ui.css" onerror="this.remove()">
<script src="{{ path_to_root }}pagefind/pagefind-ui.js" defer onerror="this.remove()"></script>
<script src="/pigments.js" defer onerror="this.remove()"></script>
{{!--
  What Pagefind records for a leaf. Without the title it takes the first <h1>
  on the page, which is the menu bar's book title, so every result would read
  "xrune · The Grimoire". print.html (the whole book again), toc.html, 404.html
  and index.html (a copy of the preface) carry no "leaf" filter, and the search
  overlay asks only for leaves.
--}}
{{#if chapter_title}}
<meta data-pagefind-meta="title[content]" content="{{ chapter_title }}">
{{#unless (eq path "index.md")}}
<meta data-pagefind-filter="leaf[content]" content="chapter">
{{/unless}}
{{/if}}

<!--
  The Grimoire's chrome, over mdBook's stock index.hbs (see theme/grimoire.css):
    · the brand, at the head of the sidebar and in the bar while it is shut
    · the running head: the book's name, then the chapter's once its title passes
    · EN | 中 and a search field in the bar
    · a kicker over each chapter (its number and part), the opening paragraph
      and its illuminated initial
    · titles on the page-turn cards, and the pigments on every casting
  A MutationObserver applies the top-of-page parts as the parser reaches them,
  so they are in place for the first paint; the rest waits for DOMContentLoaded.
-->
<script>
(function () {
  'use strict';
  var html = document.documentElement;
  var ZH = /^zh/i.test(html.lang);
  var PAGE = '{{ path }}'.replace(/\.md$/, '.html');
  var ROOT = '{{ path_to_root }}';
  var L = ZH
    ? { book: '魔典', search: '检索魔典', placeholder: '检索魔典…', prev: '前章', next: '后章',
        preface: '序章', casting: '咒文', open: '展卷', close: '合卷', home: 'xrune · 卷首' }
    : { book: 'The Grimoire', search: 'Search the grimoire', placeholder: 'Search the grimoire…', prev: 'Previous', next: 'Next',
        preface: 'Preface', casting: 'casting', open: 'open', close: 'close', home: 'xrune · home' };

  // One theme: the picker is gone, so forget a stock theme picked before it was.
  try {
    var saved = localStorage.getItem('mdbook-theme');
    if (saved && saved !== 'tome') localStorage.removeItem('mdbook-theme');
  } catch (e) { /* storage may be off */ }

  var SIGIL = '<svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="27" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width="2"/><circle cx="32" cy="32" r="21" fill="none" stroke="currentColor" stroke-opacity=".25"/><path d="M32 1v7M32 56v7M1 32h7M56 32h7" stroke="currentColor" stroke-opacity=".55" stroke-width="2"/><path d="M22.5 18.5 41.5 45.5M41.5 18.5 22.5 45.5" fill="none" stroke="currentColor" stroke-width="4.6" stroke-linecap="square"/></svg>';
  var LENS = '<svg viewBox="0 0 512 512" aria-hidden="true"><path d="M500.3 443.7 380.6 324c27.2-40.4 40.6-90.9 33.5-144.7C401.8 87.8 326.8 13.3 235.2 1.7 99-15.5-15.5 99 1.7 235.2c11.6 91.6 86.1 166.7 177.6 178.9 53.8 7.2 104.3-6.2 144.7-33.5l119.7 119.7c15.6 15.6 40.9 15.6 56.6 0 15.6-15.6 15.6-41 0-56.6zM79.1 208c0-70.6 57.4-128 128-128s128 57.4 128 128-57.4 128-128 128-128-57.4-128-128z"/></svg>';

  function esc(s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  function brand(cls) {
    return '<a class="xr-brand ' + cls + '" href="/" aria-label="' + L.home + '">' + SIGIL + '<span>xrune</span></a>';
  }
  function roman(n) {
    var out = '', table = [[10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']];
    table.forEach(function (p) { while (n >= p[0]) { out += p[1]; n -= p[0]; } });
    return out;
  }

  // ---- what a sidebar entry says about its chapter: "2.1." under "Part I — First Casting"
  function chapterOf(a) {
    var strong = a.querySelector('strong');
    var num = strong ? strong.textContent.trim().replace(/\.$/, '') : '';
    var text = a.textContent.trim();
    if (num) text = text.slice(text.indexOf(strong.textContent.trim()) + strong.textContent.trim().length).trim();
    var top = a.closest('li.chapter-item');
    while (top && top.parentElement && !top.parentElement.classList.contains('chapter')) {
      top = top.parentElement.closest('li.chapter-item');
    }
    var part = '';
    for (var p = top && top.previousElementSibling; p; p = p.previousElementSibling) {
      if (p.classList.contains('part-title')) { part = p.textContent.trim(); break; }
      if (p.classList.contains('spacer')) break;
    }
    var dot = text.indexOf(' · ');
    var c = { title: dot > 0 ? text.slice(dot + 3) : text };
    if (num) {
      var bits = num.split('.');
      c.mark = roman(+bits[0]) + (bits.length > 1 ? '.' + bits.slice(1).join('.') : '');
      c.label = part.replace(/^.*?[—–]\s*/, '');
    } else {
      // unnumbered leaves: "Appendix · The Lexicon", "序章 · …", and the preface
      c.mark = '✦';
      c.label = dot > 0 ? text.slice(0, dot) : (top && !top.previousElementSibling ? L.preface : '');
    }
    return c;
  }
  var here;
  function current() {
    if (here === undefined) {
      var a = document.querySelector('#mdbook-sidebar a.active');
      if (a) here = chapterOf(a);
    }
    return here;
  }

  // ---- the parts the first paint shows
  function side() {
    var sb = document.getElementById('mdbook-sidebar');
    if (!sb) return false;
    var head = document.createElement('div');
    head.className = 'xr-sb-head';
    head.innerHTML = brand('') + '<span class="xr-sb-sub">' + L.book + '</span>';
    sb.insertBefore(head, sb.firstChild);
    return true;
  }
  function probe(a) {
    // a translation can lag: mark its page unavailable rather than hide the language
    function off() { a.setAttribute('aria-disabled', 'true'); a.removeAttribute('href'); }
    fetch(a.href, { method: 'HEAD' }).then(function (r) { if (!r.ok) off(); }).catch(off);
  }
  function langs() {
    var w = document.createElement('span');
    w.className = 'xr-lang';
    w.setAttribute('role', 'group');
    w.setAttribute('aria-label', 'Language · 语言');
    [['en', 'EN', ZH ? ROOT + '../' + PAGE : ROOT + PAGE, 'English'],
     ['zh', '中', ZH ? ROOT + PAGE : ROOT + 'zh-CN/' + PAGE, '简体中文']].forEach(function (l) {
      var a = document.createElement('a');
      a.href = l[2];
      a.textContent = l[1];
      a.title = l[3];
      a.hreflang = l[0] === 'zh' ? 'zh-CN' : 'en';
      if ((l[0] === 'zh') === ZH) { a.className = 'on'; a.setAttribute('aria-current', 'true'); } else probe(a);
      // the landing page follows the reader's last choice
      a.addEventListener('click', function () { try { localStorage.setItem('xrune-lang', l[0]); } catch (e) { /* ignore */ } });
      w.appendChild(a);
    });
    return w;
  }
  function bar() {
    // .right-buttons is parsed after .left-buttons is complete
    var mb = document.getElementById('mdbook-menu-bar');
    var lb = mb && mb.querySelector('.left-buttons'), rb = mb && mb.querySelector('.right-buttons');
    if (!lb || !rb) return false;
    lb.insertAdjacentHTML('beforeend', brand('xr-bar-brand'));
    var s = document.createElement('button');
    s.type = 'button';
    s.className = 'xr-search';
    s.title = L.search + ' (s · /)';
    s.setAttribute('aria-label', L.search);
    s.setAttribute('aria-keyshortcuts', 's /');
    s.innerHTML = LENS + '<span>' + L.search + '</span><kbd>/</kbd>';
    s.addEventListener('click', openSearch);
    rb.insertBefore(langs(), rb.firstChild);
    rb.insertBefore(s, rb.firstChild);
    return true;
  }
  function runningHead() {
    var mt = document.querySelector('#mdbook-menu-bar .menu-title');
    if (!mt || !mt.firstChild) return false;
    var c = current();
    mt.innerHTML = '<span class="rh rh-book">' + L.book + '</span>' +
      (c ? '<span class="rh rh-ch" aria-hidden="true"><b>' + esc(c.mark) + '</b><span>' + esc(c.title) + '</span></span>' : '');
    return true;
  }
  function kicker() {
    var main = document.querySelector('#mdbook-content main');
    var h1 = main && main.firstElementChild;
    if (!h1) return false;
    var c = current();
    if (h1.tagName === 'H1' && c && c.label) {
      var k = document.createElement('p');
      k.className = 'xr-kicker';
      k.innerHTML = '<span class="num">' + esc(c.mark) + '</span><span>' + esc(c.label) + '</span>';
      main.insertBefore(k, h1);
    }
    return true;
  }
  var parsed = false;
  function lede() {
    // decided on whole paragraphs: wait until the parser has moved past them
    var h1 = document.querySelector('#mdbook-content main > h1');
    var p = h1 && h1.nextElementSibling;
    if (!p) return parsed;
    if (p.tagName !== 'P') return true;
    var q = p.nextElementSibling;
    if (!parsed && !(q && q.nextSibling)) return false;
    p.classList.add('xr-lede');
    if (!ZH) {
      // the initial is three lines deep and wants three lines of text beside it:
      // a lede too short for that takes a two-line initial, and a bare one-line
      // lede hands the initial to a long paragraph after it
      var n = p.textContent.length, two = n >= 100 && n < 160;
      var t = n >= 100 ? p : (q && q.tagName === 'P' && q.textContent.length >= 240 ? q : null);
      var first = t && t.firstChild;
      if (first && first.nodeType === 3 && /^\s*[A-Za-z]/.test(first.data)) {
        t.classList.add('xr-initial');
        if (two) t.classList.add('xr-initial-2');
      }
    }
    return true;
  }

  var steps = [side, bar, runningHead, kicker, lede], done = [];
  function enhance() {
    var pending = 0;
    for (var i = 0; i < steps.length; i++) {
      if (done[i]) continue;
      try { done[i] = steps[i](); } catch (e) { done[i] = true; }
      if (!done[i]) pending++;
    }
    return pending;
  }
  var watch = new MutationObserver(function () { if (!enhance()) watch.disconnect(); });
  watch.observe(html, { childList: true, subtree: true });

  // ---- the rest, once the leaf is parsed
  function pageTurn() {
    var nav = document.querySelector('#mdbook-content .nav-wrapper');
    if (!nav) return;
    var byHref = {};
    document.querySelectorAll('#mdbook-sidebar .chapter a[href]').forEach(function (a) {
      if (!a.closest('.on-this-page')) byHref[a.href.split('#')[0]] = a;
    });
    nav.querySelectorAll('a.mobile-nav-chapters').forEach(function (a) {
      var s = byHref[a.href.split('#')[0]], c = s && chapterOf(s), prev = a.classList.contains('previous');
      a.insertAdjacentHTML('beforeend',
        '<span class="xr-pg-k">' + (prev ? '← ' + L.prev : L.next + ' →') + '</span>' +
        '<span class="xr-pg-t">' + (c ? '<b>' + esc(c.mark) + '</b>' + esc(c.title) : '') + '</span>');
    });
    nav.classList.add('xr-pg');
  }

  // every ui! { … } / ui!( … ) in the source: the spans between its brackets
  function castings(src) {
    var out = [], re = /\bui!\s*[{(]/g, m;
    while ((m = re.exec(src))) {
      var open = m.index + m[0].length, depth = 1, i = open;
      for (; i < src.length && depth; i++) {
        var ch = src[i];
        if (ch === '"') { for (i++; i < src.length && src[i] !== '"'; i++) if (src[i] === '\\') i++; }
        else if (ch === '/' && src[i + 1] === '/') { while (i < src.length && src[i] !== '\n') i++; }
        else if (ch === '/' && src[i + 1] === '*') { var e = src.indexOf('*/', i + 2); i = e < 0 ? src.length : e + 1; }
        else if (ch === '{' || ch === '(' || ch === '[') depth++;
        else if (ch === '}' || ch === ')' || ch === ']') depth--;
      }
      var close = depth ? src.length : i - 1;
      out.push([open, close]);
      re.lastIndex = Math.max(close, open);
    }
    return out;
  }
  // paint tokens back into the block, re-opening the hidden-line spans where they were
  function emit(toks, parts, hl) {
    var out = '', pi = 0, left = parts[0].text.length, open = false;
    function enter() { if (parts[pi].boring) { out += '<span class="boring">'; open = true; } }
    function leave() { if (open) { out += '</span>'; open = false; } }
    enter();
    toks.forEach(function (t) {
      var s = t[1];
      while (s.length) {
        while (!left && pi < parts.length - 1) { leave(); pi++; left = parts[pi].text.length; enter(); }
        var piece = left ? s.slice(0, left) : s;
        out += t[0] ? '<span class="t-' + t[0] + '">' + hl.esc(piece) + '</span>' : hl.esc(piece);
        s = s.slice(piece.length);
        left = Math.max(0, left - piece.length);
      }
    });
    leave();
    return out;
  }
  function paintRust(code, hl) {
    var parts = [], walker = document.createTreeWalker(code, NodeFilter.SHOW_TEXT), n;
    while ((n = walker.nextNode())) {
      if (!n.data) continue;
      var boring = !!(n.parentElement && n.parentElement.closest('.boring'));
      var last = parts[parts.length - 1];
      if (last && last.boring === boring) last.text += n.data; else parts.push({ boring: boring, text: n.data });
    }
    if (!parts.length) return 'rust';
    var src = parts.map(function (p) { return p.text; }).join(''), toks = [], at = 0;
    castings(src).forEach(function (r) {
      if (r[0] > at) toks = toks.concat(hl.tokens('rust', src.slice(at, r[0])));
      toks = toks.concat(hl.tokens('dsl', src.slice(r[0], r[1])));
      at = r[1];
    });
    if (at < src.length) toks = toks.concat(hl.tokens('rust', src.slice(at)));
    code.innerHTML = emit(toks, parts, hl);
    // a casting whose Rust wrapper is all hidden reads as a casting
    var shown = parts.filter(function (p) { return !p.boring; }).map(function (p) { return p.text; }).join('');
    var wrapped = parts.some(function (p) { return p.boring && /\bui!\s*[{(]/.test(p.text); });
    return wrapped && !/\bui!/.test(shown) ? 'casting' : 'rust';
  }
  function pigments() {
    var hl = window.XRUNE && window.XRUNE.hl;
    document.querySelectorAll('#mdbook-content pre > code').forEach(function (code) {
      var lang = (/\blanguage-(\w+)/.exec(code.className) || [])[1] || 'text';
      var tag = lang;
      if (lang === 'rust' && hl && hl.tokens) {
        try { tag = paintRust(code, hl); } catch (e) { /* keep highlight.js */ }
      }
      code.parentNode.setAttribute('data-tag', tag === 'casting' ? L.casting : tag);
    });
  }
  function headWatch() {
    var h1 = document.querySelector('#mdbook-content main > h1'), mb = document.getElementById('mdbook-menu-bar');
    if (!h1 || !mb || !('IntersectionObserver' in window)) return;
    new IntersectionObserver(function (es) {
      var e = es[es.length - 1];
      mb.classList.toggle('past-title', !e.isIntersecting && e.boundingClientRect.top < 0);
    }, { rootMargin: '-56px 0px 0px 0px' }).observe(h1);
  }

  // ---- search: Pagefind in an overlay, built the first time it opens
  var overlay = null;
  function openSearch() {
    if (typeof PagefindUI === 'undefined') return;
    if (!overlay) {
      overlay = document.createElement('div');
      overlay.id = 'xrune-search-overlay';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', L.search);
      overlay.innerHTML = '<div id="xrune-search-modal"><div id="xrune-search"></div>' +
        '<p class="xr-search-hint"><span><kbd>↵</kbd>' + L.open + '</span><span><kbd>esc</kbd>' + L.close + '</span></p></div>';
      document.body.appendChild(overlay);
      overlay.addEventListener('click', function (e) { if (e.target === overlay) closeSearch(); });
      var ui = new PagefindUI({
        element: '#xrune-search', showSubResults: true, showImages: false, autofocus: true,
        translations: { placeholder: L.placeholder },
        // a chapter's h1 is its title: let the result itself stand for it, not a nested copy
        processResult: function (r) {
          var s = r.sub_results;
          if (s && s[0] && s[0].anchor && s[0].anchor.element === 'h1') s[0].url = (r.meta && r.meta.url) || r.url;
          return r;
        }
      });
      // leaves only: see the leaf filter above
      ui.triggerFilters({ leaf: 'chapter' });
    }
    overlay.classList.add('open');
    var input = overlay.querySelector('input');
    if (input) input.focus();
  }
  function closeSearch() { if (overlay) overlay.classList.remove('open'); }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && overlay && overlay.classList.contains('open')) { closeSearch(); e.preventDefault(); return; }
    var t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if (e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === 's' || e.key === '/') { openSearch(); e.preventDefault(); }
  });

  document.addEventListener('DOMContentLoaded', function () {
    parsed = true;
    enhance();
    watch.disconnect();
    if (typeof PagefindUI === 'undefined') html.classList.add('xr-nosearch');
    [pageTurn, pigments, headWatch].forEach(function (f) { try { f(); } catch (e) { /* the page still reads */ } });
  });
})();
</script>
